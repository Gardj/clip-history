{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clip History",
  "version": "0.1.0",
  "identifier": "dev.codex.clip-history",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Clip History",
        "width": 760,
        "height": 500,
        "minWidth": 600,
        "minHeight": 360,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": true,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
